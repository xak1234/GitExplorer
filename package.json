{
  "name": "github-commit-image-tester",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:backend": "tsc --outDir dist/server server/index.ts",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "prod": "node dist/server/index.js",
    "start": "node scripts/start.cjs",
    "start:dev": "node scripts/start.cjs --dev",
    "start:prod": "node scripts/start.cjs",
    "bundle": "npm run build && npm run build:backend",
    "setup": "node scripts/setup.js",
    "clean:workspaces": "powershell -ExecutionPolicy Bypass -File scripts/clean-workspaces.ps1"
  },
  "bin": {
    "ghcr": "./cli/index.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-git": "^3.27.0",
    "uuid": "^9.0.1",
    "validator": "^13.15.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.13",
    "@types/validator": "^13.15.4",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
